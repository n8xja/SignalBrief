# Copy this file to .env and fill in the values. Never commit .env.

# Claude API key from https://platform.claude.com (Settings -> API keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model to use (default claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# WordPress site and login
WP_URL=https://your-site.example.com
WP_USER=your-wordpress-username
# Users -> Profile -> Application Passwords -> "Add New". Spaces are fine.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: the editorial brief that guides how Claude writes (audience, angle, tone).
# Leave it out to use the built-in brief for business leaders. Keep it on one line (quotes are optional).
# EDITORIAL_BRIEF="Acme Security Weekly delivers hand-picked cybersecurity insights for business leaders. We show why specific threats deserve attention, what they mean for your organization, and what defensive actions to consider."

# Optional: numeric category ID for new drafts (Posts -> Categories, hover a category to see tag_ID)
# WP_CATEGORY_ID=5
